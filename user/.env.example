#--------------------------------------------------------------------
# KBC아카데미 공개 홈페이지 설정 견본
# 사용: cp .env.example .env  →  "입력" 표시된 값을 채운다
#       chown www-data:www-data .env && chmod 640 .env
# 이 파일에는 실제 비밀번호를 적지 않는다. (.env 는 git 에 올라가지 않음)
#--------------------------------------------------------------------

# 개발 중: development / 공개 운영: production (오류 상세 숨김, 검색 허용)
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# 주소
#--------------------------------------------------------------------
# 입력: 끝에 / 포함. 예) 'https://www.도메인/'
app.baseURL = 'https://입력/'
app.indexPage = ''
app.appTimezone = 'Asia/Seoul'
app.defaultLocale = 'ko'

#--------------------------------------------------------------------
# DB (kbc_user: 콘텐츠 조회 + 문의 등록만 가능한 계정)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = kbc_db
database.default.username = kbc_user
database.default.password = 입력
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# 쿠키 (도메인 맨 앞에서 운영하면 '/', 하위경로면 '/경로/')
#--------------------------------------------------------------------
cookie.path = '/'
cookie.secure = true
session.cookieName = 'kbc_session'
security.cookieName = 'kbc_csrf'

#--------------------------------------------------------------------
# 새 문의 알림 메일 (보내는 계정. 받는 주소는 관리자 > 사이트 설정)
# 네이버: 메일 환경설정에서 SMTP 사용 켜기, 비밀번호는 "애플리케이션 비밀번호"
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = smtp.naver.com
email.SMTPPort = 465
email.SMTPCrypto = ssl
email.SMTPTimeout = 10
email.SMTPUser = 입력@naver.com
email.SMTPPass = 입력
email.fromEmail = 입력@naver.com
email.fromName = KBC아카데미
email.mailType = text
email.charset = UTF-8
