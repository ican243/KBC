#--------------------------------------------------------------------
# KBC아카데미 관리자 설정 견본
# 사용: cp .env.example .env  →  "입력" 표시된 값을 채운다
#       chown www-data:www-data .env && chmod 640 .env
# 이 파일에는 실제 비밀번호를 적지 않는다. (.env 는 git 에 올라가지 않음)
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# 주소
#--------------------------------------------------------------------
# 입력: 관리자 주소, 끝에 / 포함. 예) 'https://admin.도메인/' 또는 'https://www.도메인/admin/'
app.baseURL = 'https://입력/'
app.indexPage = ''
app.appTimezone = 'Asia/Seoul'
app.defaultLocale = 'ko'

#--------------------------------------------------------------------
# DB (kbc_admin: 조회·등록·수정·삭제 계정)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = kbc_db
database.default.username = kbc_admin
database.default.password = 입력
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# 테이블 생성·변경 전용 계정 (마이그레이션 실행할 때만 사용)
database.migrate.hostname = localhost
database.migrate.database = kbc_db
database.migrate.username = kbc_migrate
database.migrate.password = 입력
database.migrate.DBDriver = MySQLi
database.migrate.DBPrefix =
database.migrate.port = 3306
database.migrate.charset = utf8mb4
database.migrate.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# 쿠키 (관리자 주소의 경로. admin.도메인 이면 '/', 도메인/admin 이면 '/admin/')
#--------------------------------------------------------------------
cookie.path = '/'
cookie.secure = true
session.cookieName = 'kbc_admin_session'
security.cookieName = 'kbc_admin_csrf'

#--------------------------------------------------------------------
# 암호화 키 (2단계 인증 비밀키 암호화)
# 새로 설치: php spark key:generate 로 만든다
# 서버 이전: 기존 서버의 값을 그대로 옮긴다 (바뀌면 모든 관리자의 2단계 인증을 다시 설정해야 함)
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# 기타
#--------------------------------------------------------------------
# 입력: 공개 홈페이지 주소 (관리자 화면의 "홈페이지에서 보기" 링크)
site.publicURL = 'https://입력/'

# 문의 보존 기간(일). 비워 두면 자동 파기 안 함. 회사가 정한 뒤 입력 → 문의 자동 파기 예약
inquiry.retentionDays =
